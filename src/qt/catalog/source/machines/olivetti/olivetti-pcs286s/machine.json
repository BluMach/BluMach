    "hardware": {
      "cpu": "Intel 80286 at 12 MHz (validated) or 16 MHz (experimental, as in the commercial PCS 286S); BIOS RAM/IO frequencies 12/12, 12/6 and 6/6 MHz",
      "memory": "1, 2 and 4 MB validated on the TI/OLIMCU16 board. Experimental generic ISA/AT expansion profiles also boot with 8 and 16 MB total; they prove a workable emulation path, not the existence of a specific Olivetti expansion card",
      "video": "Integrated VGA",
      "floppy": "3.5 in, 1.44 MB",
      "chipset": "Texas Instruments TACT82300 family + Olivetti OLIMCU16 ASIC",
      "rtc": "AT-compatible CMOS RTC with separate motherboard battery; exact chip unidentified",
      "coprocessor": "Intel 80287 optional",
      "expansion": "2 × 16-bit AT + 1 × 8-bit XT full-size slots",
      "interfaces": "RS-232C, bidirectional parallel, mouse, AT keyboard",
      "dimensions": "360 × 312 × 100 mm; 7.6 kg"
    },
    "firmware": {
      "known_sets": [
        "Olivetti BIOS / Resident Diagnostics 2.06 (1991-05-20)"
      ],
      "required": true,
      "identity_note": "Authentic 2 × 64 KiB LOW/HIGH EPROM dump; verified against the supplied 128 KiB interleaved image"
    },
